<UserControl x:Class="Quiz.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quiz.Views"
        xmlns:viewmodels="clr-namespace:Quiz.ViewModels"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Górne przyciski -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Importuj quiz" Command="{Binding ImportQuizCommand}" Margin="5"/>
            <Button Content="Eksportuj quiz" Command="{Binding ExportQuizCommand}" Margin="5"/>
            <Button Content="Dodaj quiz" Command="{Binding AddQuizCommand}" Margin="5"/>
            <Button Content="Edytuj quiz" Command="{Binding EditQuizCommand}" Margin="5"/>
        </StackPanel>

        <!-- Lista utworzonych quizów (po lewej stronie) -->
        <GroupBox Header="Utworzone quizy" Grid.Row="1" Grid.Column="0" Margin="10">
            <ListBox ItemsSource="{Binding QuizList}" />
        </GroupBox>

        <!-- Historia wyników quizu (po prawej stronie) -->
        <GroupBox Header="Historia wyników" Grid.Row="1" Grid.Column="1" Margin="10">
            <ListBox ItemsSource="{Binding HistoryList}" />
        </GroupBox>

    </Grid>
</UserControl>